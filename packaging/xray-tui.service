[Unit]
Description=Fluffify xray-core daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ядро Xray встроено в бинарник и создаёт TUN-адаптер само (inbound "tun"),
# поэтому фоновому демону нужны сетевые права — достаточно их у юнита.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=/usr/bin/xray-tui daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
