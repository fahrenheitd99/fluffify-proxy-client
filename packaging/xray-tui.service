[Unit]
Description=Fluffify xray-core daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Демон запускает ядро xray child-процессом. Прав на TUN у юнита нет:
# user-менеджер systemd не владеет CAP_NET_ADMIN и юнит с
# AmbientCapabilities не запускается вовсе (218/CAPABILITIES). Права выдаёт
# tun-setup: setcap на самом бинарнике ядра xray.
ExecStart=/usr/bin/xray-tui daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
